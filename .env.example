# ============================================================================
# Vermaire Hoveniers — omgevingsvariabelen
# Zet deze waarden in Vercel: Project → Settings → Environment Variables.
# Kopieer dit bestand naar .env.local voor lokale ontwikkeling (vercel dev).
# ============================================================================

# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publiek (veilig in de browser, beschermd door Row Level Security)
SUPABASE_ANON_KEY=your-anon-public-key

# GEHEIM — alleen server-side. Nooit in de browser of in git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
